# Copy to .env — never commit real values.
# Local development uses SQLite (default). For PostgreSQL put the real connection string in .env, never here:
#   DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=sqlite:///./poltracker.db
# Browser origins allowed to call the API, comma-separated, no trailing slash. Production example (placeholder):
#   CORS_ORIGINS=https://<your-project>.pages.dev
# Defaults to the local dev/preview servers (localhost and 127.0.0.1 on ports 5173 and 4173).
# CORS_ORIGINS=
# Data Status warns when the last successful ingest is older than this many hours.
INGEST_STALE_AFTER_HOURS=24
CONGRESSINVESTS_BASE_URL=https://congressinfor-production.up.railway.app
# Optional: Pro key for higher limits. Free tier is 100 requests/day per IP.
CONGRESSINVESTS_API_KEY=
INGEST_PAGE_SIZE=500
INGEST_MAX_PAGES=15
INGEST_INTERVAL_HOURS=6
BENCHMARK_TICKER=SPY
PRICE_BATCH_SIZE=40
PRICE_RETRY_DAYS=7

# Official politician enrichment (optional). Free key: https://api.congress.gov/sign-up/  Never commit a real key.
# Without it the app runs normally and enrichment reports "not configured".
CONGRESS_API_KEY=

# Optional LLM-assisted identity resolution for politician names the deterministic matcher could not resolve.
# Off by default. When on, an unresolved politician's name, chamber, state/district and the official candidates' names and
# Bioguide IDs are sent to the OpenAI API; suggestions are validated deterministically and never create data on their own.
OPENAI_API_KEY=
POLITICIAN_LLM_ENABLED=false
POLITICIAN_LLM_MODEL=gpt-4o-mini
POLITICIAN_LLM_MIN_CONFIDENCE=0.9
# false (default): validated suggestions wait in the review queue for a person to approve them as reviewed overrides.
POLITICIAN_LLM_AUTO_ACCEPT=false

# Company profiles (CIK, SIC industry, exchange) from SEC EDGAR via `python -m poltracker.enrich_securities`. The SEC asks every client
# to identify itself: put a real contact here, for example "Jane Doe jane@example.com". Not a secret, but do not commit your own.
SEC_USER_AGENT=

# OpenAI-written explanations of trade context (python -m poltracker.analyze_trade_context_llm). Uses OPENAI_API_KEY above. The model only explains
# the structured facts the deterministic engine already calculated; it never decides a signal or a flag. Default flagged trades only, 25 calls per run.
POLTRACKER_TRADE_LLM_MODEL=…
POLTRACKER_TRADE_LLM_MAX_CALLS=…
# Optional, for the run summary's cost estimate only (USD per million tokens). Rates change: set your own; none is assumed.
POLTRACKER_TRADE_LLM_INPUT_USD_PER_MTOK=…
POLTRACKER_TRADE_LLM_OUTPUT_USD_PER_MTOK=…

# Saved context views and the last-used screen are writes to a local table. The desktop app always has them; enable them for a local web API with 1. Leave unset on a public deployment.
POLTRACKER_LOCAL_VIEWS=…
