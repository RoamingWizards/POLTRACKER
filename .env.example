# Copy to .env — never commit real values.
# Local development uses SQLite (default). For PostgreSQL put the real connection string in .env, never here:
#   DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=sqlite:///./poltracker.db
# Browser origins allowed to call the API, comma-separated, no trailing slash. Production example (placeholder):
#   CORS_ORIGINS=https://<your-project>.pages.dev
# Defaults to the local dev/preview servers (localhost and 127.0.0.1 on ports 5173 and 4173).
# CORS_ORIGINS=
# Data Status warns when the last successful ingest is older than this many hours.
INGEST_STALE_AFTER_HOURS=24
CONGRESSINVESTS_BASE_URL=https://congressinfor-production.up.railway.app
# Optional: Pro key for higher limits. Free tier is 100 requests/day per IP.
CONGRESSINVESTS_API_KEY=
INGEST_PAGE_SIZE=500
INGEST_MAX_PAGES=15
INGEST_INTERVAL_HOURS=6
BENCHMARK_TICKER=SPY
PRICE_BATCH_SIZE=40
PRICE_RETRY_DAYS=7
